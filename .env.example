DATA_DIR=data/raw

# Phase 3: experiment tracking
MLFLOW_TRACKING_URI=

# Phase 3-6: database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Phase 4: API admin token (protects the reload endpoint)
API_ADMIN_TOKEN=
